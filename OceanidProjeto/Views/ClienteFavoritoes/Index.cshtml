@model IEnumerable<OceanidProjeto.Models.ClienteFavorito>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.produto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ativo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.cliente.idCliente)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.produto.idProd)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ativo)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.idClienteFav">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.idClienteFav">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.idClienteFav">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>