<link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
<section class="wishlist">
    <h2>Wishlist</h2>
    <div class="wishlist-container">

        @foreach (var favorito in ViewBag.clienteFavoritos as List<ClienteFavorito>)
        {
            var produto = favorito.produto;
            <div class="wishlist-item">

                <div class="product-card">
                    <div class="product-header">
                        <form asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                            <input type="hidden" name="idProd" value="@produto.idProd" />
                            <button type="submit" class="btn-favoritar" style="border:none; background-color:transparent;" >
                                <i class="bi bi-heart-fill text-danger fs-4"></i>
                            </button>
                        </form>
                    </div>

                    <div class="product-image">
                        <img src="@Url.Content(produto.imagemUrl ?? "~/img/produtos/sem-imagem.png")" alt="@produto.nomeProd" />
                    </div>

                    <div class="product-info">
                        <h3 class="product-name">@produto.nomeProd</h3>
                        <p class="product-brand">@produto.marcaProd</p>

                    </div>

                    <div class="product-actions">
                        <a asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="@produto.idProd"> Ver mais </a>
                        <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                            <input type="hidden" name="id" value="@produto.idProd" />
                            <input type="hidden" name="quantidade" value="1" />
                            <button type="submit" class="btn-add-to-cart">
                                <img src="~/img/icon-shopping-prod.png" alt="Adicionar ao carrinho">
                            </button>
                        </form>
                    </div>
                </div>



            </div>
        }
    </div>
</section>

<link href="~/css/site.css" rel="stylesheet" />
<script src="~/js/site.js" asp-append-version="true"></script>