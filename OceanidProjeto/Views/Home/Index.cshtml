@{
    ViewData["Title"] = "Home Page";
}

@model OceanidProjeto.Models.ItemPedido;
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

@if (TempData["FavoritoMsg"] != null)
{
    <div id="popupFavorito" class="alert alert-success text-center shadow rounded-pill position-fixed top-0 start-50 translate-middle-x mt-3 px-5 py-3" style="z-index: 9999; color:#054154; background-color:#ABDDDE;">
        @TempData["FavoritoMsg"]
    </div>
}

<body>
    <style>
        .favorite {
            font-size: 2rem;
            cursor: pointer;
            transition: color 0.3s;
            border: none;
        }

        .favorited {
            color: red;
        }

        #mensagem {
            margin-top: 10px;
            color: #ABDDDE;
            font-weight: bold;
            display: none;
        }
    </style>

    <!-- Carrossel -->
    <div id="carouselExample" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/carrossel/1.png" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/carrossel/2.png" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/carrossel/3.png" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/carrossel/4.png" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Formulário de login -->
    <form class="menu-login" id="menu-login" asp-controller="Logins" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="cad-text">
            <p>Login</p>
            <img src="~/img/fechar-icon.png" alt="Fechar" onclick="menuLogin()" class="icon-menu">
        </div>

        <div class="menu" id="menu">
            <div class="input-holders">
                <input type="email" name="email" id="email" class="inputUser" required>
                <label class="label-input" for="email">E-mail</label>
            </div>

            <div class="input-holders" style="position: relative;">
                <input type="password" name="senha" id="senha" class="inputUser senhaCliente" required>
                <label class="label-input" for="senha">Senha</label>
                <img src="~/img/eye-icon.png" alt="Mostrar senha" class="toggle-eye" onclick="toggleSenha()" />
            </div>

            <div class="links-log">
         
                <a href="#" onclick="abrirCadastro()">Faça já o seu cadastro!</a>
            </div>
        </div>

        <div class="cad-text2">
            <input type="submit" value="Entrar">
            <div class="logout">
                <a asp-controller="Logins" asp-action="Logout">
                    <div class="logout">
                        <img src="~/img/logout.png" alt="logout" />
                        <p>LogOut</p>
                    </div>
                </a>
            </div>
            <p>
                Ao assinar a Oceanid Skin Beauty, você concorda com nossos Termos de Uso e Política de Privacidade e consente em receber um número variável de mensagens de marketing por e-mail e texto.
                O consentimento não é uma condição para nenhuma compra. Podem ser aplicadas taxas de mensagem e dados. Responda AJUDA para obter ajuda ou PARE para cancelar.
                Residentes da Califórnia: consulte também nossos Termos de Incentivo Financeiro.
            </p>
        </div>
    </form>

    @if (TempData["Login"] != null)
    {
        <div id="popupLogin" class="alert alert-success text-center shadow rounded-pill position-fixed top-0 start-50 translate-middle-x mt-3 px-5 py-3" style="z-index: 9999; display: none;">
            @TempData["Login"]
        </div>
    }

    <div class="tudo-cad" id="overlay-cad" onclick="fecharCadastro()"></div>

    <!-- Formulário de cadastro -->
    <form class="menu-cad" id="menu-cad" asp-controller="Clientes" asp-action="Cadastro" method="post">
        <div class="cad-holder">
            <div class="cad-text">
                <p>Cadastre-se</p>
                <img src="~/img/fechar-icon.png" alt="Fechar" onclick="fecharCadastro()" class="icon-menu">
            </div>

            <div class="inputCad-holder">
                <div class="input-holders">
                    <input type="text" name="cpf" class="inputUser" required>
                    <label class="label-input">CPF</label>
                </div>

                <div class="input-holders">
                    <input type="text" name="nomeCompleto" class="inputUser" required>
                    <label class="label-input">Nome completo</label>
                </div>

                <div class="input-holders">
                    <input type="text" name="endereco" class="inputUser" required>
                    <label class="label-input">Endereço completo</label>
                </div>

                <div class="input-holders">
                    <input type="date" name="dataNasc" class="inputUser" required>
                </div>

                <div class="input-holders">
                    <input type="email" name="emailCliente" class="inputUser" required>
                    <label class="label-input">E-mail</label>
                </div>

                <div class="input-holders" style="position: relative;">
                    <input type="password" name="senhaCliente" id="senhaCliente2" class="inputUser senhaCliente" required>
                    <label class="label-input" for="senha">Senha</label>
                    <img src="~/img/eye-icon.png" alt="Mostrar senha" class="toggle-eye" onclick="toggleSenha2()" />
                </div>
            </div>

            <div class="btn-cad">
                <input type="submit" value="Cadastre-se" />
            </div>
        </div>
    </form>

    @if (TempData["popupCad"] != null)
    {
        <div id="popupCad" class="alert alert-success text-center shadow rounded-pill position-fixed top-0 start-50 translate-middle-x mt-3 px-5 py-3" style="z-index: 9999; display: none;">
            @TempData["popupCad"]
        </div>
    }

    <!-- Overlay Sacola -->
    <div class="overlay-sacola" id="sacola-overlay" onclick="fecharSacola()"></div>

    <!-- Produtos -->
    <section class="destaques">
        <h2 class="section-title">Nossos Produtos</h2>
        <div class="grid-produtos">
            @foreach (var produto in ViewBag.ProdutosDoBanco as List<Produto>)
            {
                var promocaoativa = produto.Promocao?.FirstOrDefault(p => p.ativa && p.dataInicio <= DateTime.Now && p.dataFim >= DateTime.Now);
                decimal precoFinal = produto.precoProd;
                decimal? valorDesconto = null;
                string tipoDesconto = "";

                if (promocaoativa != null)
                {
                    if (promocaoativa.tipoDesconto == "Percentual" && promocaoativa.valorDesconto.HasValue)
                    {
                        valorDesconto = promocaoativa.valorDesconto;
                        precoFinal = produto.precoProd * (1 - (valorDesconto.Value / 100));
                        tipoDesconto = $"{valorDesconto}% OFF";
                    }
                    else if (promocaoativa.tipoDesconto == "Valor Fixo" && promocaoativa.precoPromocional.HasValue)
                    {
                        precoFinal = promocaoativa.precoPromocional.Value;
                        valorDesconto = produto.precoProd - precoFinal;
                        tipoDesconto = $"R$ {valorDesconto.Value.ToString("N2")} OFF";
                    }
                }

                <div class="product-card">
                @* @if (promocaoativa != null)
                    {
                        <div class="promo-badge">@tipoDesconto</div>
                    }*@   

                    <div class="product-header">
                        <form asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                            <input type="hidden" name="idProd" value="@produto.idProd" />
                            <button type="submit" class="btn-favoritar" style="font-size:25px; border:none; background-color:transparent;">
                                <i class="bi bi-heart favorite" data-prod-id="@produto.idProd" style="font-size:25px; border:none; background-color:transparent;"></i>
                            </button>
                        </form>
                    </div>

                    <div class="product-image">
                        <img src="@Url.Content(produto.imagemUrl ?? "~/img/produtos/sem-imagem.png")" alt="@produto.nomeProd" />
                    </div>

                    <div class="product-info">
                        <h3 class="product-name">@produto.nomeProd</h3>
                        <p class="product-brand">@produto.marcaProd</p>
                        <div class="product-price">
                            @if (promocaoativa != null)
                            {
                                <span class="original-price">R$ @produto.precoProd.ToString("N2")</span>
                            }
                            <span class="final-price">R$ @precoFinal.ToString("N2")</span>
                            @if (promocaoativa != null)
                            {
                                <span class="discount-type">@tipoDesconto</span>
                            }
                        </div>
                    </div>
                   
                    <div class="product-actions">
                      <a asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="@produto.idProd">Ver mais</a>
                       
                      
                        <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                            <input type="hidden" name="id" value="@produto.idProd" />
                            <input type="hidden" name="quantidade" value="1" />
                            <button type="submit" class="btn-add-to-cart">
                                <img src="~/img/icon-shopping-prod.png" alt="Adicionar ao carrinho">
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>

 

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const popupFavorito = document.getElementById('popupFavorito');
            if (popupFavorito) {
                popupFavorito.style.display = 'block';
                setTimeout(() => {
                    popupFavorito.style.display = 'none';
                }, 3000);
            }
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
