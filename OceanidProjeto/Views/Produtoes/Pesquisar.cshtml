@model List<OceanidProjeto.Models.Produto>
    


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2>Resultados da Pesquisa</h2>

@if (Model != null && Model.Any())
{
    <div class="destaques">
        <div class="grid-produtos">
            @foreach (var produto in Model)
            {
                <div class="product-card">

                    <div class="product-header">
                        <form asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                            <input type="hidden" name="idProd" value="@produto.idProd" />
                            <button type="submit" class="btn-favoritar" style="font-size:25px; border:none; background-color:transparent;">
                                <i class="bi bi-heart favorite" data-prod-id="@produto.idProd" style="font-size:25px; border:none; background-color:transparent;"></i>
                            </button>
                        </form>
                    </div>

                    <div class="product-image">
                        <img src="@Url.Content(produto.imagemUrl ?? "~/img/produtos/sem-imagem.png")" alt="@produto.nomeProd" />
                    </div>

                    <div class="product-info">
                        <h3 class="product-name">@produto.nomeProd</h3>
                        <p class="product-brand">@produto.marcaProd</p>
                    </div>

                    <div class="product-actions">
                        <a asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="@produto.idProd">Ver mais</a>
                        <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                            <input type="hidden" name="id" value="@produto.idProd" />
                            <input type="hidden" name="quantidade" value="1" />
                            <button type="submit" class="btn-add-to-cart">
                                <img src="~/img/icon-shopping-prod.png" alt="Adicionar ao carrinho">
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <p>Nenhum produto encontrado.</p>
}