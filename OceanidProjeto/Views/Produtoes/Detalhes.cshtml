@model OceanidProjeto.Models.Produto

<!-- CSS específico da página -->
<link href="~/css/Detalhes.css" rel="stylesheet" />

@{
    var promocaoativa = Model.Promocao?.FirstOrDefault(p =>
        p.ativa && p.dataInicio <= DateTime.Now && p.dataFim >= DateTime.Now);

    decimal precoFinal = Model.precoProd;
    decimal? valorDesconto = null;
    string tipoDesconto = "";

    if (promocaoativa != null)
    {
        if (promocaoativa.tipoDesconto == "Percentual" && promocaoativa.valorDesconto.HasValue)
        {
            valorDesconto = promocaoativa.valorDesconto;
            precoFinal = Model.precoProd * (1 - (valorDesconto.Value / 100));
            tipoDesconto = $"{valorDesconto}% OFF";
        }
        else if (promocaoativa.tipoDesconto == "Valor Fixo" && promocaoativa.precoPromocional.HasValue)
        {
            precoFinal = promocaoativa.precoPromocional.Value;
            valorDesconto = Model.precoProd - precoFinal;
            tipoDesconto = $"R$ {valorDesconto.Value.ToString("N2")} OFF";
        }
    }
}

<!-- PRODUTO EM DESTAQUE -->
<div class="product-card-detalhes">
    <div class="product-image-detalhes">
        <img src="@Url.Content(Model.imagemUrl ?? "~/img/produtos/sem-imagem.png")" alt="@Model.nomeProd" />
    </div>
    <div class="product-header-detalhes">
        <form asp-controller="ClienteFavoritoes" asp-action="Favoritar" class="form-detalhes btn-favoritar" method="post">
            <input type="hidden" name="idProd" value="@Model.idProd" />
            <button type="submit" class="btn-favoritar">
                <i class="bi bi-heart favv" style="font-size:20px; border:none; background-color:transparent;"></i>
            </button>
        </form>
    </div>

    <div class="product-info-detalhes">
        <h3 style="font-size:30px;" class="product-name">@Model.nomeProd</h3>
        <p class="product-brand">@Model.marcaProd</p>

        <div class="product-price-detalhes">
            @if (promocaoativa != null)
            {
                <span class="original-price">R$ @Model.precoProd.ToString("N2")</span>
            }
            <span class="final-price">R$ @precoFinal.ToString("N2")</span>

            @if (promocaoativa != null)
            {
                <span class="discount-type">@tipoDesconto</span>
            }
        </div>

        <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
            <input type="hidden" name="id" value="@Model.idProd" />
            <input type="hidden" name="quantidade" value="1" />
            <button type="submit" class="btn-add-to-cart- carrinho-detalhes">
                <i class ="bi bi-cart"></i> Adicionar ao carrinho
            </button>
        </form>
    </div>
</div>

<!-- CARROSSEL DE PRODUTOS -->
<div class="product-carousel-wrapper">
    <button class="product-carousel-button prev">&#10094;</button>

    <div class="product-carousel-container">
        <div class="product-carousel-track">
            @foreach (var produto in ViewBag.ProdutosDoBanco as List<Produto>)
            {
                if (produto.idProd == Model.idProd)
                {
                    continue; // Pula o produto principal já exibido acima
                }

                <div class="product-card-detalhes-carrossel">
                    <div class="product-header">
                        <form asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                            <input type="hidden" name="idProd" value="@produto.idProd" />
                            <button type="submit" class="btn-favoritar">
                                <i class="bi bi-heart fav-detalhes"></i>
                            </button>
                        </form>
                    </div>

                    <div class="product-image-container">
                        <img src="@(string.IsNullOrEmpty(produto.imagemUrl) ? Url.Content("/assets/img/default-image.png") : produto.imagemUrl)"
                             alt="@produto.nomeProd"
                             class="product-image-detalhes-carrossel"
                             onerror="this.onerror=null;this.src='@Url.Content("/assets/img/default-image.png")';" />
                    </div>

                    <div class="product-info-carrossel">
                        <h5 class="product-name">@produto.nomeProd</h5>
                        <p class="product-price">@produto.precoProd.ToString("C")</p>

                        <div class="product-actions-carrossel">
                            <a class="btn-details" asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="@produto.idProd">
                                Ver detalhes
                            </a>
                            <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                                <input type="hidden" name="id" value="@produto.idProd" />
                                <input type="hidden" name="quantidade" value="1" />
                                <button type="submit" class="btn-add-to-cart">
                                    <i class="bi bi-cart"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <button class="product-carousel-button next">&#10095;</button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.querySelector('.product-carousel-track');
        const btnPrev = document.querySelector('.product-carousel-button.prev');
        const btnNext = document.querySelector('.product-carousel-button.next');
        const cardWidth = 320;

        let currentPosition = 0;

        btnPrev.addEventListener('click', () => {
            currentPosition -= cardWidth;
            if (currentPosition < 0) currentPosition = 0;
            track.style.transform = `translateX(-${currentPosition}px)`;
        });

        btnNext.addEventListener('click', () => {
            const maxScroll = track.scrollWidth - track.parentElement.offsetWidth;
            currentPosition += cardWidth;
            if (currentPosition > maxScroll) currentPosition = maxScroll;
            track.style.transform = `translateX(-${currentPosition}px)`;
        });
    });
</script>
