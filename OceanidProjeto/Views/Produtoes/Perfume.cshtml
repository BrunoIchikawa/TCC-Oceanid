<!-- Bootstrap e CSS -->
<link href="~/css/site.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Banner da Categoria -->
<div class="banner-categoria">
    <img id="themeImgperfume" src="~/img/perfume_light.png" alt="Imagem do Produto" style="height:270px;" />
</div>

<div class="grid-produtos">
    <!-- Card Estático (mantido sem alterações de IDs e classes) -->
    <div class="product-card">
        <div class="product-header">
            <form class="btn-favoritar" asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                <input type="hidden" name="idProd" value="0" />
                <button type="submit" class="btn-favoritar" style="font-size:25px; border:none; background-color:transparent;">
                    <i class="bi bi-heart favorite" data-prod-id="0" style="font-size:20px; border:none; background-color:transparent;"></i>
                </button>
            </form>
        </div>
        <div class="product-image">
            <img src="~/img/produtos-perfume/img1.png" alt="Produto estático" />
        </div>
        <div class="product-info">
            <h3 class="product-name">Produto Exemplo</h3>
            <p class="product-brand">Marca Exemplo</p>
        </div>
        <div class="product-actions">
            <a style="font-size:0.9rem;" class="btn-details" asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="0">
                Ver detalhes
            </a>
            <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                <input type="hidden" name="id" value="0" />
                <input type="hidden" name="quantidade" value="1" />
                <button type="submit" class="btn-add-to-cart">
                    <i style="font-size:1rem;" class="bi bi-cart"></i>
                </button>
            </form>
        </div>
    </div>


