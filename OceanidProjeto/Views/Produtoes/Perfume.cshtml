<!-- Bootstrap e CSS -->
<link href="~/css/site.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Banner da Categoria -->
<div class="banner-categoria">
    <img id="themeImgperfume" src="~/img/perfume_light.png" alt="Imagem do Produto" style="height:270px;" />
</div>

<!-- Listagem de Categorias e Produtos -->
@foreach (var categoria in ViewBag.CategoriaProdutos as List<Categoria>)
{
    <!--<h2>@categoria.nomeCategoria</h2>-->
    <div class="grid-produtos">
        @foreach (var produto in categoria.Produtos)
        {
            <div class="product-card">
                <!-- Botão de Favoritar -->
                <div class="product-header">
                    <form class="btn-favoritar" asp-controller="ClienteFavoritoes" asp-action="Favoritar" method="post">
                        <input type="hidden" name="idProd" value="@produto.idProd" />
                        <button type="submit" class="btn-favoritar" style="font-size:25px; border:none; background-color:transparent;">
                            <i class="bi bi-heart favorite" data-prod-id="@produto.idProd" style="font-size:20px; border:none; background-color:transparent;"></i>
                        </button>
                    </form>
                </div>

                <!-- Imagem do Produto -->
                <div class="product-image">
                    <img src="@Url.Content(produto.imagemUrl ?? "~/img/produtos/sem-imagem.png")" alt="@produto.nomeProd" />
                </div>

                <!-- Informações do Produto -->
                <div class="product-info">
                    <h3 class="product-name">@produto.nomeProd</h3>
                    <p class="product-brand">@produto.marcaProd</p>
                </div>

                <div class="product-actions">
                    <a style="font-size:0.9rem;" class="btn-details" asp-controller="Produtoes" asp-action="Detalhes" asp-route-id="@produto.idProd">
                        Ver detalhes
                    </a>
                    <form method="post" asp-controller="Pedidoes" asp-action="AdicionarItem">
                        <input type="hidden" name="id" value="@produto.idProd" />
                        <input type="hidden" name="quantidade" value="1" />
                        <button type="submit" class="btn-add-to-cart">
                            <i style="font-size:1rem;" class="bi bi-cart"></i>
                        </button>
                    </form>
                </div>
            </div>

        }
    </div>
}
