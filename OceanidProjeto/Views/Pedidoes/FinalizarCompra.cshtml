@model OceanidProjeto.Models.Cliente;

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">Confirme seus dados</h3>
                    <form asp-controller="Clientes" asp-action="Cadastro" method="post">
                        <input asp-for="cpf" class="form-control" />
                        <input asp-for="nomeCompleto" class="form-control" />
                        <input asp-for="dataNasc" type="date" class="form-control" />
                        <input asp-for="emailCliente" type="email" class="form-control" />
                        <input asp-for="senhaCliente" type="password" class="form-control" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleSenha2() {
        var senha = document.getElementById("senhaCliente2");
        senha.type = senha.type === "password" ? "text" : "password";
    }
</script>