@model IEnumerable<OceanidProjeto.Models.ItemPedido>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.idProd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecoUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.pedido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.produto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.idProd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantidade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecoUnitario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.pedido.idPed)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.produto.descricaoProd)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idItemPedido">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idItemPedido">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idItemPedido">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
